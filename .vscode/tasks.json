{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build BigInt Project (prj2)",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                // Arquivos de código-fonte na subpasta 'prj2'
                "${workspaceFolder}\\prj2\\prj2.c",
                "${workspaceFolder}\\prj2\\bigint.c",
                "${workspaceFolder}\\prj2\\listaencad.c",
                // Opções de saída
                "-o",
                "${workspaceFolder}\\prj2\\prj2.exe"
            ],
            "options": {
                // Definindo o diretório de trabalho para que os includes funcionem
                "cwd": "${workspaceFolder}\\prj2"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila e linka todos os arquivos .c na subpasta prj2."
        }
    ],
    "version": "2.0.0"
